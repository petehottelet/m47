{
  "manifest_version": 3,
  "name": "M47 — retro terminal interface",
  "version": "0.2.0",
  "description": "Re-renders the web as a calm retro sci-fi terminal: black ground, warm curved chrome, pill controls, condensed uppercase type. Open-source art project.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "bg/service_worker.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/swept.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*"], "matches": ["http://*/*", "https://*/*"] }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "M47",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "cycle-mode": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Cycle M47 mode for this site (full, palette, off)"
    }
  }
}
